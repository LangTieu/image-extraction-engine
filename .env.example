# Image Extraction Engine — service configuration (P7)
# Copy to .env and adjust. Every value is optional; defaults in service/core/settings.py.

# Extraction
SERVICE_PROFILE=industrial
SERVICE_MAX_UPLOAD_MB=20

# Storage (SQLite default; PostgreSQL URL works unchanged)
# SERVICE_DB_URL=postgresql+psycopg://user:pass@localhost/iee
# SERVICE_DB_URL=sqlite:///./service/data/service.db

# Security: set a key to require X-API-Key on every /v1 call (except /v1/health)
# IMAGE_ENGINE_API_KEY=change-me
SERVICE_RATE_LIMIT_PER_MINUTE=60
SERVICE_RETENTION_DAYS=30

# Worker: inprocess (default, no Redis) or rq
SERVICE_WORKER_MODE=inprocess
# SERVICE_REDIS_URL=redis://localhost:6379/0

# CORS (comma separated)
SERVICE_CORS_ORIGINS=*

# External vision APIs stay off unless explicitly enabled
SERVICE_EXTERNAL_VISION_APIS=false
